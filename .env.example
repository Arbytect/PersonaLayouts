# Site and checkout
PL_SITE_ORIGINS=https://www.personalayouts.com,https://personalayouts.com
PL_SITE_URL=https://www.personalayouts.com
DODO_PAYMENTS_MODE=test
DODO_PAYMENTS_API_KEY=
DODO_PRODUCT_ID_39=
DODO_PRODUCT_ID_59=
DODO_RETURN_URL=https://www.personalayouts.com/download.html
DODO_CANCEL_URL=https://www.personalayouts.com/checkout.html
DODO_WEBHOOK_SECRET=
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=
PL_REQUIRE_TURNSTILE=true

# Verified webhook forwarding
MAKE_PAID_ORDER_WEBHOOK_URL=
MAKE_GIFT_WEBHOOK_URL=
MAKE_FORWARD_SECRET=
PL_INTERNAL_API_SECRET=

# Render delivery service
DELIVERY_WEBHOOK_SECRET=
DELIVERY_SERVER_HOST=0.0.0.0
PORT=8787

# Protocol Admin (database provisioning comes with the admin application phase)
DATABASE_URL=
PL_DATABASE_SSL=true
PL_ADMIN_AUTO_MIGRATE=false
PL_ADMIN_ORIGIN=https://personalayouts-pdf-backend.onrender.com
PL_ADMIN_BOOTSTRAP_EMAIL=
PL_ADMIN_BOOTSTRAP_PASSWORD=
PL_ADMIN_BOOTSTRAP_NAME=Persona Layouts Admin
PL_ADMIN_SESSION_HOURS=12

# Cloudflare R2
PL_R2_ACCOUNT_ID=
PL_R2_ACCESS_KEY_ID=
PL_R2_SECRET_ACCESS_KEY=
PL_R2_BUCKET_NAME=personalayouts
PL_R2_SIGNED_URL_TTL=86400
GIFT_R2_SIGNED_URL_TTL=604800

# Paid AI processing ($59)
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o
REPLICATE_API_TOKEN=
# shadow: deliver normally and write an admin review packet; hold: generate/upload but do not issue a customer download URL.
PL_PROTOCOL_ADMIN_REVIEW_MODE=shadow

# Local-only QA
PL_TEST_PHOTO_PATH=
